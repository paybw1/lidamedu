# rag-lab 전용 환경변수. 실제 값은 .env 에 (커밋 금지)
#
# Supabase — DB 정적 export(읽기 전용 SELECT)용.
# service_role 키를 사용하되 본 실험 코드는 INSERT/UPDATE/DELETE 호출이 없다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 임베딩 (Voyage AI) — feat-9 §14 결정과 정렬: voyage-3-large, 1024차원
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIM=1024

# LLM (Anthropic) — feat-9 §14 결정: claude-sonnet-4-6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 비용 가드 — 실 호출 전 dry-run 으로 확인.
# 임베딩/생성 호출 전 예상 비용을 stdout에 표시하고 confirm 필요.
DRY_RUN=true
